# Required for background web push token registration (Firebase Console > Project settings > Cloud Messaging > Web Push certificates)
VITE_FIREBASE_VAPID_KEY=REPLACE_WITH_FIREBASE_WEB_PUSH_CERTIFICATE_KEY_PAIR

# Set this in Netlify environment variables, NOT in VITE_* variables or client source.
OPENAI_API_KEY=REPLACE_WITH_SERVER_SIDE_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini
